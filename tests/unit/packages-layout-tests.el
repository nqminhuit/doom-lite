;;; packages-layout-tests.el --- installed package layout matches a frozen fixture -*- lexical-binding: t; -*-

;; Regenerate the fixture from a synced tree with:
;;   emacs --batch -Q -l tests/unit/packages-layout-tests.el -f pl-test-write-fixture

(require 'ert)
(require 'cl-lib)

(defconst pl-test-root
  (expand-file-name "../.." (file-name-directory (or load-file-name buffer-file-name))))

;; The only place that knows where build dirs live.
(defconst pl-test-build-root ".local/straight/build-31.1/")

(defconst pl-test-fixture "tests/fixtures/packages-layout.eld")

(defconst pl-test-builtins
  '(compat project eldoc seq external-completion which-key use-package flymake
    vc vc-annotate smerge-mode eglot jsonrpc xref transient treesit))

;; Directories listed by recipes, so a lost directory entry is caught even if it holds no .el.
(defconst pl-test-recipe-dirs
  '(("nerd-icons" "data") ("evil-collection" "modes") ("ghostel" "etc" "src" "vendor")))

(defun pl-test--path (rel) (expand-file-name rel pl-test-root))

(defun pl-test--build-root () (pl-test--path pl-test-build-root))

(defun pl-test--synced-p () (file-directory-p (pl-test--build-root)))

(defun pl-test--package-names ()
  "Installed package names: every build dir except straight's own."
  (sort (cl-loop for f in (directory-files (pl-test--build-root) nil "\\`[^.]")
                 when (and (file-directory-p (expand-file-name f (pl-test--build-root)))
                           (not (equal f "straight")))
                 collect f)
        #'string<))

(defun pl-test--autoload-names (file)
  "Sorted symbol names FILE declares through (autoload 'SYM ...) forms."
  (when (file-exists-p file)
    (with-temp-buffer
      (insert-file-contents file)
      (let (names)
        (while (re-search-forward "^(autoload #?'\\([^ \n]+\\) " nil t)
          (push (match-string 1) names))
        (sort (delete-dups names) #'string<)))))

(defun pl-test--capture-package (name)
  (let ((dir (expand-file-name name (pl-test--build-root))))
    (list name
          ;; .dir-locals.el is a dotfile, not a library; recipes may drop it.
          :el (sort (cl-remove-if (lambda (f) (equal (file-name-nondirectory f) ".dir-locals.el"))
                                  (directory-files-recursively dir "\\.el\\'" nil nil nil))
                    #'string<)
          :dirs (mapcar (lambda (d) (cons d (file-directory-p (expand-file-name d dir))))
                        (cdr (assoc name pl-test-recipe-dirs)))
          :autoloads (pl-test--autoload-names
                      (expand-file-name (concat name "-autoloads.el") dir)))))

(defun pl-test--relativize (entry)
  "Make the :el paths of ENTRY relative to its build dir."
  (let* ((name (car entry))
         (dir (file-name-as-directory (expand-file-name name (pl-test--build-root)))))
    (cons name (plist-put (copy-sequence (cdr entry)) :el
                          (mapcar (lambda (f) (file-relative-name f dir))
                                  (plist-get (cdr entry) :el))))))

(defun pl-test--capture ()
  "Return the layout of the synced tree as (:packages ALIST)."
  (list :packages (mapcar (lambda (n) (pl-test--relativize (pl-test--capture-package n)))
                          (pl-test--package-names))))

(defun pl-test--read-fixture ()
  (with-temp-buffer
    (insert-file-contents (pl-test--path pl-test-fixture))
    (read (current-buffer))))

(defun pl-test-write-fixture ()
  "Capture the synced tree into the fixture file."
  (let ((data (append (pl-test--capture) (list :built-in pl-test-builtins))))
    (with-temp-file (pl-test--path pl-test-fixture)
      (insert ";; Generated by `pl-test-write-fixture' in tests/unit/packages-layout-tests.el.\n")
      (insert "(\n")
      (insert " :built-in " (prin1-to-string (plist-get data :built-in)) "\n")
      (insert " :packages\n (\n")
      (dolist (entry (plist-get data :packages))
        (insert "  (" (prin1-to-string (car entry)) "\n")
        (cl-loop for (k v) on (cdr entry) by #'cddr
                 do (insert "   " (prin1-to-string k) " " (prin1-to-string v) "\n"))
        (insert "  )\n"))
      (insert " ))\n"))))

(ert-deftest pl-test-built-ins-come-from-emacs ()
  "Under `emacs -Q', every :built-in package resolves inside the Emacs install."
  (dolist (name (plist-get (pl-test--read-fixture) :built-in))
    (let ((file (locate-library (symbol-name name))))
      (should file)
      (should (file-in-directory-p file lisp-directory))
      (should-not (file-in-directory-p file (pl-test--path ".local"))))))

(ert-deftest pl-test-installed-layout-matches-fixture ()
  (unless (pl-test--synced-p)
    (ert-skip (format "%s not synced; run bin/lite doom sync" pl-test-build-root)))
  (let ((want (plist-get (pl-test--read-fixture) :packages))
        (have (plist-get (pl-test--capture) :packages)))
    (should (equal (mapcar #'car have) (mapcar #'car want)))
    (dolist (w want)
      (let ((h (assoc (car w) have)))
        (should (equal (plist-get (cdr h) :el) (plist-get (cdr w) :el)))
        (should (equal (plist-get (cdr h) :dirs) (plist-get (cdr w) :dirs)))
        (should (equal (plist-get (cdr h) :autoloads) (plist-get (cdr w) :autoloads)))))))

(ert-deftest pl-test-fixture-covers-41-packages ()
  (should (= 41 (length (plist-get (pl-test--read-fixture) :packages)))))

(provide 'packages-layout-tests)
;;; packages-layout-tests.el ends here
