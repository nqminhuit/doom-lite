#!/usr/bin/env doomscript
;;; bin/doom-bump --- move package pins to upstream HEAD -*- lexical-binding: t; mode: emacs-lisp -*-
;;; Commentary:
;;; Code:

(require 'doom-packages)

(defcli! bump
    (&args packages)
  "Bump the :pin of packages to their upstream HEAD.

Resolves the newest commit of each package's repo (its :branch, if the recipe
has one), lists what changed with compare links, asks for confirmation, then
rewrites the :pin in the packages.el that sets it. If PACKAGES are given, only
their repos are checked. Does not sync or commit; run 'doom sync', test, then
commit."
  (doom-packages-bump (mapcar #'intern packages) (get! :suppress-prompts?))
  t)

;;; doom-bump ends here
