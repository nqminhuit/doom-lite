#!/usr/bin/env doomscript
;;; bin/doom-install --- Doom Emacs install wizard -*- lexical-binding: t; mode: emacs-lisp -*-
;;; Commentary:
;;; Code:

(require 'doom-packages)


;;
;;; * Variables

;; None yet!


;;
;;; * Commands

(defcli! install
    (&flags
     (envfile? ("--env")          "(Re)generate an envvars file? (see `$ doom help env`)")
     (install? ("--install" :yes) "Auto-install packages?"))
  "Installs and sets up Doom Emacs for the first time.

This command does the following:

  1. Checks that `$DOOMDIR' holds a config (an init.el),
  2. Prompts you to generate an envvar file (same as `$ doom sync --env`),
  3. Installs any dependencies of enabled modules (specified by `$DOOMDIR'/init.el),

doom-lite ships no starter config, so `$DOOMDIR' must already exist. This
command is idempotent and safe to reuse.

Change `$DOOMDIR' with the `--doomdir' option, e.g.

  ```
  $ doom --doomdir /other/doom/config install
  ```"
  (print! (green "Installing Doom Emacs!\n"))
  (let ((default-directory doom-emacs-dir)
        (yes? (get! :suppress-prompts?)))
    (unless (file-exists-p (doom-path doom-user-dir doom-module-init-file))
      (user-error "No config found at %s; set $DOOMDIR (or --doomdir) to your config first"
                  (abbreviate-file-name doom-user-dir)))

    (doom-load (doom-path doom-user-dir doom-module-init-file) t)
    (doom-load (doom-path doom-user-dir doom-module-cli-file) t)

    ;; Ask if user would like an envvar file generated
    (if (eq envfile? :no)
        (print! (warn "Not generating envvars file, as requested"))
      (setq envfile?
            (if (or yes?
                    (eq envfile? :yes)
                    (y-or-n-p "Generate an envvar file? (see `doom help env` for details)"))
                :yes
              :no)))

    (if (eq install? :no)
        (print! (warn "Not installing plugins, as requested"))
      (when (file-exists-p "~/.emacs")
        (print! (warn "~/.emacs file detected. Delete it or Emacs won't load Doom correctly!")))

      (put! :installing? t)
      (exit! "doom" "sync" (if (eq envfile? :yes) "--env")))))


;;
;;; * Execute

(run! "install" (cdr (member "--" argv)))

;;; doom-install ends here
